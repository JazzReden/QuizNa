# Local memory demo. Copy to backend/.env; real values must remain untracked.
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
DEMO_MODE=true
DATABASE_MODE=memory
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
PAPER_AI_ENABLED=false
LOCAL_REGISTRATION_ENABLED=true
# Optional XAMPP testing only:
# DATABASE_MODE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=YOUR_LOCAL_DATABASE
# MYSQL_USER=YOUR_LOCAL_APP_USER
# MYSQL_PASSWORD=YOUR_LOCAL_PASSWORD
# Optional backend-only essay AI:
# PAPER_AI_PROVIDER=gemini
# GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_KEY
# QuizNa uses Supabase Auth JWT verification and its Data API.
# DATABASE_URL and JWT_SECRET are not used; do not invent extra credentials.
# For Render use deploy/render.env.example instead of these demo defaults.
