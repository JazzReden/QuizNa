# Backend: copy server variables to backend/.env. Frontend: copy only VITE_* variables to frontend/.env.
# Never place service-role keys or database passwords in frontend/.env.
TRUST_PROXY_HOPS=0
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5173
# Existing local previews may still use CORS_ORIGIN; production requires FRONTEND_URL.
# Ephemeral seeded demo, local use only. Set false when connecting Supabase.
DEMO_MODE=true
DATABASE_MODE=memory
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
VITE_API_URL=http://localhost:3002
VITE_DEMO_MODE=true
# Optional developer shortcuts, hidden in client screens by default.
VITE_SHOW_DEMO_ACCESS=false
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional persistent local XAMPP mode (backend only):
# DATABASE_MODE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
# MYSQL_DATABASE=quizna_local
# MYSQL_USER=quizna_local
# MYSQL_PASSWORD=your-local-app-password

# Optional handwriting + essay suggestions (backend only; teacher confirmation required).
# Gemini offers a limited free tier: use a free-tier project and sample essays.
PAPER_AI_PROVIDER=gemini
GEMINI_API_KEY=your-server-only-gemini-api-key
GEMINI_ESSAY_MODEL=gemini-3.8-flash
# Add your own API key to backend/.env, never frontend/.env or a VITE_* variable.
PAPER_AI_ENABLED=false
OPENAI_API_KEY=your-server-only-openai-api-key
OPENAI_ESSAY_MODEL=gpt-5.6-terra

# Backend only: close registration during a controlled public preview.
# Existing teacher/student accounts can still sign in.
LOCAL_REGISTRATION_ENABLED=true
